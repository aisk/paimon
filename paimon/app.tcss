/* Styles for PaimonApp. Loaded via PaimonApp.CSS_PATH. */

Screen { background: $background; }
/* 100% rather than the default 1fr: fr widths resolve against the container
   minus the widest sibling margins, and the status bar's own 0 2 margin would
   otherwise shave four dead columns off the right edge of every pane. */
#panes { height: 1fr; width: 100%; }
SessionPane { height: 1fr; margin: 1 2 0 2; }

/* ---- pane tabs ---- */

/* A row of tabs along the bottom edge, hidden entirely while a single pane is
   open. The tabs draw their own frames (paimon/tabs.py), so there are no
   borders here, only the room to draw in. */
#pane-tabs { dock: bottom; layout: horizontal; height: 3; padding: 0 2; }
#pane-tabs-fill { width: 1fr; height: 3; color: $text-muted; }
.pane-tab {
    width: auto;
    height: auto;
    color: $text-muted;
    text-wrap: nowrap;
}
.pane-tab:hover { color: $text; }
.pane-tab.-attention { color: $warning; }
.pane-tab.-active { color: $text; text-style: bold; }

/* The strip opens with a rule, so the status bar's own breathing room below
   would only hold the two apart for nothing. Spelled in full: a single-edge
   margin rule resets the other three rather than merging with the shorthand. */
Screen.-tabs-bottom #statusbar { margin: 0 2 0 2; }

* {
    scrollbar-size-vertical: 1;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-color: $primary 55%;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
}

/* ---- conversation log ---- */

#log {
    height: 1fr;
    padding: 0 1 1 1;
    scrollbar-gutter: stable;
}
#log > * { margin-bottom: 1; }
.assistant { padding: 0 1; }
.reasoning { color: $text-disabled; text-style: italic; text-opacity: 60%; }
.tool-result { color: $text-disabled; }
.todos { padding: 0 1; border-left: solid $primary 45%; }
/* Unprompted, so it is the quietest block that still has a rule of its own.
   The Markdown widget's own default padding and $foreground would both win
   over "quiet", so both are restated here. */
.recap { padding: 0 1; border-left: solid $accent 60%; color: $text-muted; }
/* A heading that slips past the recap instructions still belongs to the muted
   block, and the breathing room the log gives blocks is enough for it. */
.recap MarkdownHeader { color: $text-muted; margin: 0 0 1 0; text-style: b; }
.tool-result.denied { color: $text; background: $error 20%; padding: 0 1; }
.user-message {
    width: 100%;
    height: auto;
    padding: 1 2;
    background: $primary 12%;
    border-left: solid $primary;
}

/* ---- status, queue, prompt ---- */

#response-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}
#response-status LoadingIndicator { width: 3; height: 1; color: $primary; }
#response-status .status-label { width: auto; }
#queued { height: auto; padding: 0 1; color: $text-muted; }
/* A background task's tab: its output fills the pane, with one line under it
   saying whether the command is still running. */
#task-status { height: 1; padding: 0 1; color: $text-muted; }
#prompt {
    height: auto;
    min-height: 4;
    max-height: 12;
    padding: 0 1;
    border: round $surface-lighten-2;
    background: transparent;
}
#prompt:focus { border: round $primary; background: transparent; }
#statusbar { height: 1; margin: 0 2 1 2; padding: 0 1; color: $text-muted; }

/* ---- permission confirmation ---- */

.confirm-panel {
    height: auto;
    margin-top: 1;
    padding: 1 2;
    border: round $warning;
    background: transparent;
}
.confirm-panel:focus { border: round $warning; }
#confirm-detail { height: auto; max-height: 12; margin-top: 1; color: $text-muted; }
#confirm-options { height: auto; margin-top: 1; }

/* ---- modal screens (login, pickers) ---- */

LoginScreen, PickerScreen, PromptScreen { align: center middle; }
#picker-box, #prompt-screen-box, #login-status {
    width: 70%; height: auto; max-height: 70%;
    padding: 1 2; border: round $accent; background: $surface;
}
#picker-title, #prompt-screen-title { margin-bottom: 1; }
#picker-filter { margin-bottom: 1; }
#picker-list { height: auto; max-height: 20; }
