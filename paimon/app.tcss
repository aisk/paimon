/* Styles for PaimonApp. Loaded via PaimonApp.CSS_PATH. */

Screen { background: $background; }
/* 100% rather than the default 1fr: fr widths resolve against the container
   minus the widest sibling margins, and the status bar's own 0 2 margin would
   otherwise shave four dead columns off the right edge of every pane. */
#panes { height: 1fr; width: 100%; }
SessionPane, AgentPane { height: 1fr; margin: 1 2 0 2; }

/* ---- pane tabs ---- */

/* A compact strip along the bottom edge, hidden entirely while a single pane
   is open. Its first row is a separator; the second carries the labels. */
#pane-tabs { dock: bottom; layout: horizontal; height: 2; padding: 0 2; }
#pane-tabs-fill { width: 1fr; height: 2; color: $text-muted; }
.pane-tab {
    width: auto;
    height: 2;
    color: $text-muted;
    text-wrap: nowrap;
}
.pane-tab:hover { color: $text; background: $primary 6%; }
.pane-tab.-active { color: $text; text-style: bold; }
.pane-tab.-attention { color: $warning; }

/* The strip opens with a rule, so the status bar's own breathing room below
   would only hold the two apart for nothing. Spelled in full: a single-edge
   margin rule resets the other three rather than merging with the shorthand. */
Screen.-tabs-bottom #statusbar { margin: 0 2 0 2; }

* {
    scrollbar-size-vertical: 1;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-color: $primary 55%;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
}

/* ---- conversation log ---- */

#log {
    height: 1fr;
    padding: 0 1 1 1;
    scrollbar-gutter: stable;
}
#log > * { margin-bottom: 1; }
.assistant { padding: 0 1; }
.reasoning { color: $text-disabled; text-style: italic; text-opacity: 60%; }
.tool-result { color: $text-disabled; }
/* Consecutive agent tool calls collapse to one activity line. Expanding the
   group reveals summary rows; only expanding a row reveals arguments/output. */
.tool-group {
    height: auto;
    padding: 0 1;
    border-left: solid $surface-lighten-2;
}
.tool-group-header, .tool-entry-header {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
.tool-group-header:hover, .tool-entry-header:hover { background: $primary 8%; }
.tool-group-header:focus, .tool-entry-header:focus {
    background: $primary 30%;
    text-style: bold reverse;
}
#log:focus { background: $primary 4%; }
.tool-group-body { height: auto; margin-top: 1; }
.tool-entry { height: auto; }
.tool-entry-header { padding-left: 1; color: $text-muted; }
.tool-entry.-failed > .tool-entry-header,
.tool-entry.-denied > .tool-entry-header { color: $warning; }
.tool-entry-detail {
    height: auto;
    margin: 0 0 1 2;
    padding-left: 1;
    border-left: solid $surface-lighten-2;
}
.tool-entry-detail > .tool-result { padding-left: 1; }
/* The calls a run_code script made, listed above its output. */
.tool-nested { color: $text-muted; padding-left: 1; }
/* A "!" command the user ran themselves: the same box as a step, told apart
   by its rule, since nothing the model did led to it. */
.shell-step { height: auto; padding: 0 1; border-left: solid $accent; }
.edit-call { height: auto; }
.edit-call-diff { margin-top: 1; }
.todos { padding: 0 1; border-left: solid $primary 45%; }
/* Unprompted, so it is the quietest block that still has a rule of its own.
   The Markdown widget's own default padding and $foreground would both win
   over "quiet", so both are restated here. */
.recap { padding: 0 1; border-left: solid $accent 60%; color: $text-muted; }
/* A heading that slips past the recap instructions still belongs to the muted
   block, and the breathing room the log gives blocks is enough for it. */
.recap MarkdownHeader { color: $text-muted; margin: 0 0 1 0; text-style: b; }
.tool-result.denied { color: $text; background: $error 20%; padding: 0 1; }
/* The expanded body of a /skill:name turn, folded above the user's words. */
.skill-invocation { color: $text-muted; padding: 0 2; }
.user-message {
    width: 100%;
    height: auto;
    padding: 1 2;
    background: $primary 12%;
    border-left: solid $primary;
}

/* ---- status, queue, prompt ---- */

#response-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}
#response-status LoadingIndicator { width: 3; height: 1; color: $primary; }
#response-status .status-label { width: auto; }
#queued { height: auto; padding: 0 1; color: $text-muted; }
/* A background command's tab: its output fills the pane, with one line under
   it saying whether the command is still running. */
#command-status { height: 1; padding: 0 1; color: $text-muted; }
#prompt {
    height: auto;
    min-height: 4;
    max-height: 12;
    padding: 0 1;
    border: round $surface-lighten-2;
    background: transparent;
}
#prompt:focus { border: round $primary; background: transparent; }
/* A line starting with "!" runs as a shell command instead of being sent. */
#prompt.bash { border: round $surface-lighten-2; }
#prompt.bash:focus { border: round $accent; }
#statusbar { height: 1; margin: 0 2 1 2; padding: 0 1; color: $text-muted; }

/* ---- permission confirmation and questions ---- */

.blocking-panel {
    height: auto;
    margin-top: 1;
    padding: 1 2;
    border: round $surface-lighten-2;
    background: transparent;
}
.blocking-panel:focus, .blocking-panel:focus-within {
    border: round $warning;
    background: $warning 5%;
}
.question-panel:focus, .question-panel:focus-within {
    border: round $accent;
    background: $accent 5%;
}
#confirm-detail, #question-detail { height: auto; max-height: 12; margin-top: 1; color: $text-muted; }
#question-detail { color: $text; }
#confirm-options, #question-options { height: auto; margin-top: 1; }
#question-input { margin-top: 1; }

/* ---- modal screens (login, pickers) ---- */

LoginScreen, BrowserLoginScreen, PickerScreen, PromptScreen { align: center middle; }
#picker-box, #prompt-screen-box, #login-status {
    width: 70%; height: auto; max-height: 70%;
    padding: 1 2; border: round $accent; background: $surface;
}
/* The sign-in address runs to many lines, and the input under it must stay in view. */
BrowserLoginScreen #prompt-screen-box { max-height: 100%; overflow-y: auto; }
#picker-title, #prompt-screen-title { margin-bottom: 1; }
#picker-filter, #browser-login-notice, #browser-login-status, #browser-login-copy { margin-bottom: 1; }
#picker-list { height: auto; max-height: 20; }
